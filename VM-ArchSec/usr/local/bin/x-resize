#!/bin/bash
LOG_FILE=/var/log/autores/autores.log
echo "Resize Event: $(date)" >> $LOG_FILE

for u in $(who | awk '{print $1}' | sort -u); do
    [[ $u = root ]] && continue

    DISP=$(sudo ps e -u "$u" | grep -oP 'DISPLAY=\K[^ ]+' | head -1)
    [[ -z "$DISP" ]] && continue

    XAUTH=$(sudo ps e -u "$u" | grep -oP 'XAUTHORITY=\K[^ ]+' | head -1)
    [[ -z "$XAUTH" ]] && XAUTH="/home/$u/.Xauthority"

    OUTPUT=$(sudo -u "$u" DISPLAY="$DISP" XAUTHORITY="$XAUTH" xrandr | awk '/ connected/{print $1; exit}')
    echo "User: $u | Display: $DISP | Output: $OUTPUT" >> $LOG_FILE

    sudo -u "$u" DISPLAY="$DISP" XAUTHORITY="$XAUTH" xrandr --output "$OUTPUT" --auto >> $LOG_FILE 2>&1
    sleep 0.5
    sudo -u "$u" DISPLAY="$DISP" XAUTHORITY="$XAUTH" \
        feh --bg-fill /home/$u/Pictures/wallpaper/dasdadasdasdasd.jpg >> $LOG_FILE 2>&1
    echo "Feh exit code: $?" >> $LOG_FILE
done
