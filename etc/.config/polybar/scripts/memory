#!/usr/bin/env bash
# memory — Polybar, roda uma vez (interval=5 no config.ini)

ICON=" "

awk -v icon="$ICON" '
/^MemTotal:/     { mem_total=$2 }
/^MemAvailable:/ { mem_available=$2 }
END {
    pct = (mem_total > 0) ? (mem_total - mem_available) / mem_total * 100 : 0

    if      (pct > 90) color="#f7768e"
    else if (pct > 80) color="#FFA500"
    else               color="#e0e8ff"

    printf "%%{F%s}%s%02d%%%%{F-}\n", color, icon, pct
}
' /proc/meminfo
