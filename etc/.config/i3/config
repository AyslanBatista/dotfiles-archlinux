# =============
# AUTOSTART
#
# ORDEM E LÓGICA:
#
# [0] systemd + graphical-session.target — DEVE ser o primeiro.
#     Propaga DISPLAY/XAUTHORITY/DBUS para o systemd user daemon e
#     ativa o graphical-session.target. Sem isso, o Ghostty service
#     (que tem WantedBy=graphical-session.target) nunca inicia
#     automaticamente no login.
#
# [1] nvidia-settings — configura GPU antes de qualquer app gráfico.
#
# [2] polkit — agente de autenticação. Deve estar pronto antes de
#     qualquer app que precise de elevação (virt-manager, pamac etc).
#
# [3] dunst — sistema de notificações. Deve estar pronto antes de
#     qualquer exec que use notify-send (nitrogen, scripts etc).
#
# [4] dex — processa entradas XDG autostart. Vai depois de dunst
#     para que apps iniciados por ele possam emitir notificações.
#
# [5] GTK settings + display — import-gsettings aplica tema GTK,
#     xset desativa screensaver e DPMS.
#
# [6] Ghostty service — iniciado pelo systemd via graphical-session.target
#     (habilitado com: systemctl enable --user app-com.mitchellh.ghostty.service)
#     O exec abaixo é um fallback caso o service não tenha subido ainda.
#     Com o service ativo, o ghostty +new-window no keybind já basta.
#
# [7] Visual — polybar e wallpaper. Exec_always para recarregar no
#     restart do i3 ($mod+Shift+r), que é o comportamento correto.
#
# [8] picom — por último, sem sleep. O picom v13 (yshui) aguarda
#     internamente o X estar estável. O sleep 1 era um workaround
#     desnecessário que apenas atrasava o startup.
# =============

# [0] systemd — propaga sessão X11 e ativa graphical-session.target
exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS && systemctl --user start graphical-session.target

# [1] NVIDIA — carrega configurações salvas (PowerMizer, ForceCompositionPipeline etc)
exec --no-startup-id nvidia-settings --load-config-only

# [2] Polkit — agente de autenticação gráfico
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# [3] Notificações
exec --no-startup-id /usr/bin/dunst

# [4] XDG autostart
exec --no-startup-id dex --autostart --environment i3

# [5] Configurações GTK + display
exec --no-startup-id $HOME/.config/i3/scripts/import-gsettings
exec --no-startup-id xset s off
exec --no-startup-id xset -dpms

# [6] Wallpaper
exec --no-startup-id nitrogen --restore

# [7] Polybar — exec_always para recarregar no $mod+Shift+r
exec_always --no-startup-id ~/.config/polybar/launch.sh

# [8] Picom — sem sleep, yshui v13 não precisa
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

# [9] Autotiling — layout automático de janelas
exec_always --no-startup-id autotiling
