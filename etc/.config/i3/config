# ================================
# i3 Window Manager Configuration
# Arch Linux / NVIDIA GTX 1660 SUPER / Dual Monitor 60Hz
# Última revisão: Abril 2026
# ================================

# =============
# BASIC SETTINGS
# =============

font pango: Noto Sans Regular 10
set $mod Mod4
workspace_layout default

# Bordas: 2px pixel (sem titlebar, apenas borda fina)
new_window pixel 2
gaps inner 4
gaps outer 2

floating_modifier $mod

# =============
# WORKSPACE VARIABLES
# =============
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

# =============
# NAVEGAÇÃO ENTRE JANELAS
# =============

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+b focus up
bindsym $mod+o focus right

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# =============
# MOVER JANELAS
# =============

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+b move up
bindsym $mod+Shift+o move right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# =============
# CONTROLE DE WORKSPACES
# =============

bindsym $mod+Tab       workspace next
bindsym $mod+Shift+Tab workspace prev

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# Workspace vazio
bindsym $mod+apostrophe exec --no-startup-id ~/.config/i3/scripts/empty_workspace
bindsym $mod+Shift+apostrophe exec --no-startup-id ~/.config/i3/scripts/move_to_empty_workspace

# =============
# LAYOUT E JANELAS
# =============

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle

bindsym $mod+g layout stacking
bindsym $mod+s layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space       focus mode_toggle

bindsym $mod+a focus parent
bindsym $mod+q kill

# =============
# REDIMENSIONAR JANELAS
# =============

bindsym $mod+Ctrl+Right resize shrink width  1 px or 1 ppt
bindsym $mod+Ctrl+Down  resize grow   height 1 px or 1 ppt
bindsym $mod+Ctrl+Up    resize shrink height 1 px or 1 ppt
bindsym $mod+Ctrl+Left  resize grow   width  1 px or 1 ppt

# =============
# APLICAÇÕES E ATALHOS
# =============

# Terminal — usa +new-window para comunicar via D-Bus com o processo
# já iniciado pelo systemd, evitando reinicialização completa do GTK.
# Resultado: abertura em ~20ms vs ~300ms com 'exec ghostty' direto.
bindsym $mod+Return       exec --no-startup-id ghostty +new-window
bindsym $mod+Shift+Return exec --no-startup-id xfce4-terminal

# Aplicações principais
bindsym $mod+e exec --no-startup-id /usr/bin/codium
bindsym $mod+w exec --no-startup-id /usr/bin/brave
bindsym $mod+n exec --no-startup-id /usr/bin/thunar

# Screenshots e QR
bindsym $mod+Shift+p exec --no-startup-id ~/.config/i3/scripts/qrscan.sh
bindsym Print         exec --no-startup-id scrot ~/%Y-%m-%d-%T-screenshot.png && notify-send "Screenshot saved"
bindsym Shift+Print   exec --no-startup-id flameshot gui

# Aplicações com function keys
bindsym $mod+F2  exec --no-startup-id /usr/bin/discord
bindsym $mod+F3  exec --no-startup-id /usr/bin/Telegram
bindsym $mod+F4  exec --no-startup-id /usr/bin/obs
bindsym $mod+F5  exec --no-startup-id ~/.config/i3/scripts/rofi-beats.sh
bindsym $mod+F6  scratchpad show
bindsym $mod+F9  exec --no-startup-id /usr/bin/zoom
bindsym $mod+F10 exec --no-startup-id virt-manager
bindsym $mod+F12 exec --no-startup-id ~/.config/i3/scripts/powermenu

# =============
# ROFI
# =============

bindsym $mod+d exec --no-startup-id rofi -show drun -show-icons
bindsym $mod+r exec --no-startup-id rofi -show emoji -modi emoji
bindsym $mod+t exec --no-startup-id rofi -show window

# =============
# CONTROLES DO SISTEMA
# =============

bindsym $mod+l       exec --no-startup-id ~/.config/i3/scripts/lock-kiosk.sh
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+i exec --no-startup-id ~/.config/i3/scripts/power-profiles
bindsym F1           exec --no-startup-id ~/.config/i3/scripts/keyhint

# =============
# CONTROLES DE MÍDIA
# =============

bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_down
bindsym XF86AudioMute        exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_mute

bindsym $mod+XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +1% && pkill -RTMIN+1 i3blocks
bindsym $mod+XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -1% && pkill -RTMIN+1 i3blocks

bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

bindsym XF86MonBrightnessUp   exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh brightness_up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh brightness_down

# =============
# REGRAS DE JANELAS FLUTUANTES
# =============

for_window [class="Yad"               instance="yad"]                floating enable
for_window [class="Galculator"        instance="galculator"]         floating enable
for_window [class="Qalculate"         instance="qalculate-gtk"]      floating enable
for_window [class="Blueberry.py"      instance="blueberry.py"]       floating enable
for_window [class="Xsane"             instance="xsane"]              floating enable
for_window [class="Pavucontrol"       instance="pavucontrol"]        floating enable
for_window [class="qt5ct"             instance="qt5ct"]              floating enable
for_window [class="Bluetooth-sendto" instance="bluetooth-sendto"]    floating enable
for_window [class="Pamac-manager"]                                   floating enable
for_window [window_role="About"]                                     floating enable
for_window [class="Windscribe"]                                      floating enable

# Borda pixel 2 para todas as janelas
for_window [class=".*"] border pixel 2

# =============
# ESQUEMA DE CORES
# =============

set $darkbluetrans  #08052be6
set $darkblue       #08052b
set $lightblue      #5294e2
set $urgentred      #e53935
set $white          #ffffff
set $black          #000000
set $purple         #e345ff
set $darkgrey       #383c4a
set $grey           #b0b5bd
set $mediumgrey     #8b8b8b
set $yellowbrown    #e1b700

set $bg_normal     #000711
set $bg_focus      #222222
set $bg_urgent     #ff0000
set $fg_normal     #02d2f7
set $fg_focus      #2777ff
set $fg_urgent     #ffffff
set $border_normal #000000
set $border_focus  #02d2f7

# Cores das janelas
client.focused          $border_focus  $darkblue  $white  $border_focus  $border_focus
client.unfocused        $darkblue      $darkblue  $grey   $border_normal $border_normal
client.focused_inactive $darkblue      $darkblue  $grey   $border_normal $black
client.urgent           $urgentred     $urgentred $white  $border_focus  $yellowbrown

focus_on_window_activation urgent
force_display_urgency_hint 500 ms

