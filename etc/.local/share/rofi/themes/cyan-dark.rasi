/*******************************************************
 * ROFI cyan-dark theme
 * Based on EndeavourOS deep-purple structure
 * Colors: black background, blue/cyan accents
 *******************************************************/
* {
    /* --- Palette --- */
    background:                  rgba ( 10, 10, 14, 95 % );
    normal-background:           rgba ( 10, 10, 14, 0 % );
    alternate-normal-background: rgba ( 18, 22, 30, 80 % );
    selected-normal-background:  rgba ( 0, 180, 200, 20 % );
    active-background:           rgba ( 0, 160, 200, 10 % );
    alternate-active-background: rgba ( 0, 160, 200, 15 % );
    selected-active-background:  rgba ( 0, 200, 220, 25 % );
    urgent-background:           rgba ( 180, 30, 30, 15 % );
    alternate-urgent-background: rgba ( 180, 30, 30, 20 % );
    selected-urgent-background:  rgba ( 200, 40, 40, 80 % );

    foreground:                  rgba ( 200, 230, 240, 100 % );
    normal-foreground:           @foreground;
    alternate-normal-foreground: @foreground;
    selected-normal-foreground:  rgba ( 0, 230, 255, 100 % );
    active-foreground:           rgba ( 0, 200, 255, 100 % );
    alternate-active-foreground: @active-foreground;
    selected-active-foreground:  rgba ( 255, 255, 255, 100 % );
    urgent-foreground:           rgba ( 255, 100, 100, 100 % );
    alternate-urgent-foreground: @urgent-foreground;
    selected-urgent-foreground:  rgba ( 255, 255, 255, 100 % );

    border-color:                rgba ( 0, 180, 220, 70 % );
    separatorcolor:              rgba ( 0, 150, 200, 40 % );
    background-color:            rgba ( 0, 0, 0, 0 % );

    lightbg:                     rgba ( 220, 240, 255, 100 % );
    lightfg:                     rgba ( 60, 80, 100, 100 % );
    blue:                        rgba ( 0, 160, 220, 100 % );
    red:                         rgba ( 220, 50, 47, 100 % );
    spacing:                     2;
}

window {
    background-color: @background;
    border:           2;
    border-color:     @border-color;
    border-radius:    12px;
    padding:          10;
}

mainbox {
    border:  0;
    padding: 8px;
}

message {
    border:       1px 0px 0px;
    border-color: @separatorcolor;
    padding:      6px;
}

textbox {
    text-color: @foreground;
}

listview {
    fixed-height: 0;
    border:       1px 0px 0px;
    border-color: @separatorcolor;
    spacing:      4px;
    scrollbar:    true;
    padding:      6px 0px 0px;
}

element {
    border:        0;
    border-radius: 6px;
    padding:       4px 8px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}

element-icon {
    background-color: inherit;
    size:             1.2em;
}

element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}
element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}

scrollbar {
    width:        3px;
    border:       0;
    border-radius: 2px;
    handle-color: @border-color;
    handle-width: 6px;
    padding:      0;
}

mode-switcher {
    border:       1px 0px 0px;
    border-color: @separatorcolor;
    spacing:      4px;
    padding:      4px 0px 0px;
}

button {
    spacing:       0;
    border-radius: 6px;
    padding:       2px 6px;
    text-color:    @normal-foreground;
}

button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

inputbar {
    spacing:       0;
    text-color:    @normal-foreground;
    padding:       6px 8px;
    border-radius: 8px;
    background-color: rgba ( 18, 22, 30, 90 % );
    children:      [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}

entry {
    spacing:    0;
    text-color: @foreground;
}

prompt {
    spacing:    0;
    text-color: @border-color;
}

textbox-prompt-colon {
    expand:     false;
    str:        " ";
    margin:     0px 0.3em 0em 0em;
    text-color: @border-color;
}
